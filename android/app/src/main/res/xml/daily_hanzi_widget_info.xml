<?xml version="1.0" encoding="utf-8"?>
<!--
  updatePeriodMillis is a coarse, OS-driven safety net only: Android enforces
  a de-facto ~30 minute floor on this value regardless of what's declared, and
  it simply re-renders whatever phrase is already stored (see
  DailyHanziWidgetProvider.onUpdate) rather than picking a new one. The real,
  user-configured refresh cadence (1h/2h/4h/6h/1 day) is driven by the
  WorkManager periodic job scheduled from PhraseRefreshWorker, which is the
  supported way to get closer-to-on-time background execution on modern
  Android without fighting Doze/App Standby.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:maxResizeWidth="360dp"
    android:maxResizeHeight="360dp"
    android:updatePeriodMillis="3600000"
    android:initialLayout="@layout/widget_daily_hanzi"
    android:previewImage="@mipmap/ic_launcher"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description" />
