<?xml version="1.0" encoding="utf-8"?>
<!--
  RemoteViews only supports a limited subset of Views/ViewGroups (no
  ConstraintLayout, no custom views). This layout intentionally sticks to
  LinearLayout + TextView so it renders identically across launchers and
  widget hosts, and reflows reasonably across the 2x2 to 4x4 size range
  thanks to resizeMode="horizontal|vertical" in the widget's provider info.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_hsk_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_background"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="@color/widget_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:text="HSK 1" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_hanzi"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="@color/widget_text_primary"
        android:textSize="32sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:text="你好" />

    <TextView
        android:id="@+id/widget_pinyin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/widget_accent"
        android:textSize="15sp"
        android:maxLines="1"
        android:text="Nǐ hǎo" />

    <TextView
        android:id="@+id/widget_definition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="@color/widget_text_secondary"
        android:textSize="13sp"
        android:maxLines="2"
        android:text="Hello" />

</LinearLayout>
