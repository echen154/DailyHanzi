<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Reference only. If you add the "App Groups" capability to the DailyHanzi
  target via Xcode's Signing & Capabilities tab (the recommended path — see
  README.md), Xcode creates and wires up an entitlements file like this one
  for you automatically. This file is provided so the required App Group ID
  is documented and so it can be used directly if you prefer wiring
  entitlements by hand (Build Settings -> Code Signing Entitlements).
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.dailyhanzi.shared</string>
    </array>
</dict>
</plist>
