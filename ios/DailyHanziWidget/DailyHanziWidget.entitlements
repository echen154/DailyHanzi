<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Reference only — see the note in ios/DailyHanzi/DailyHanzi.entitlements.
  The DailyHanziWidget extension target needs the same App Group as the main
  app target, or SharedStore.swift will silently fall back to
  UserDefaults.standard and the widget will never see data from the app.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.dailyhanzi.shared</string>
    </array>
</dict>
</plist>
