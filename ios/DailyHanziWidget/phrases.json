  { "id": "hsk6-04", "simplified": "遏制", "traditional": "遏制", "pinyin": "Èzhì", "definition": "To contain; to curb", "exampleSentence": "政府正在努力遏制通货膨胀。", "exampleSentencePinyin": "Zhèngfǔ zhèngzài nǔlì èzhì tōnghuò péngzhàng.", "exampleSentenceTranslation": "The government is working hard to curb inflation.", "hskLevel": 6, "topic": "Society", "tags": ["verb"] },
  { "id": "hsk6-05", "simplified": "隐患", "traditional": "隱患", "pinyin": "Yǐnhuàn", "definition": "Hidden danger", "exampleSentence": "这个设备存在安全隐患。", "exampleSentencePinyin": "Zhège shèbèi cúnzài ānquán yǐnhuàn.", "exampleSentenceTranslation": "This equipment has a hidden safety hazard.", "hskLevel": 6, "topic": "Safety", "tags": ["noun"] },
  { "id": "hsk6-06", "simplified": "抉择", "traditional": "抉擇", "pinyin": "Juézé", "definition": "Choice; decision", "exampleSentence": "面对人生的抉择，他很纠结。", "exampleSentencePinyin": "Miànduì rénshēng de juézé, tā hěn jiūjié.", "exampleSentenceTranslation": "Facing this life choice, he felt very conflicted.", "hskLevel": 6, "topic": "Life", "tags": ["noun"] },
