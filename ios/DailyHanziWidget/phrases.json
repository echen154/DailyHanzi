  { "id": "hsk6-10", "simplified": "悖论", "traditional": "悖論", "pinyin": "Bèilùn", "definition": "Paradox", "exampleSentence": "这是一个著名的逻辑悖论。", "exampleSentencePinyin": "Zhè shì yí ge zhùmíng de luójí bèilùn.", "exampleSentenceTranslation": "This is a famous logical paradox.", "hskLevel": 6, "topic": "Academic", "tags": ["noun"] },
